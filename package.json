{
    "name":  "dsh-plugin-human-input",
    "version":  "0.3.0",
    "description":  "让 AI 像人一样操控 Windows：缓动曲线移动鼠标、按下抬起、拖拽、逐字输入，并可截图确认结果。Human-like mouse \u0026 keyboard control for DSH.",
    "type":  "module",
    "main":  "index.js",
    "exports":  {
                    ".":  "./index.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg",
                    "./package.json":  "./package.json"
                },
    "icon":  "./icon.svg",
    "files":  [
                  "index.js",
                  "cordis.patch.yml",
                  "scripts/human-input-driver.ps1",
                  "locale/*.json",
                  "icon.svg",
                  "README.md",
                  "SPONSOR.md",
                  "docs/reward-qr.jpg",
                  "LICENSE"
              ],
    "keywords":  [
                     "dsh",
                     "dsh-bundle",
                     "deepseek-harness",
                     "plugin",
                     "computer-use",
                     "mouse",
                     "keyboard",
                     "automation",
                     "human-like",
                     "windows",
                     "gui-automation",
                     "rpa"
                 ],
    "engines":  {
                    "node":  "\u003e=20",
                    "dsh":  "\u003e=0.2.0-rc.5 \u003c0.3.0"
                },
    "os":  [
               "win32"
           ],
    "license":  "MIT",
    "author":  "20700499ww-byte",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/20700499ww-byte/dsh-plugin-human-input.git"
                   },
    "homepage":  "https://github.com/20700499ww-byte/dsh-plugin-human-input#readme",
    "dsh":  {
                "manifestVersion":  1,
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "publishConfig":  {
                          "access":  "public"
                      }
}